# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0. Task 3 baseline: platform bring-up only, no storage.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Without this the BCM2837 target maps PLATFORM_PANIC_LOG_PADDR (0x3c0fc000, RAM on a
# Raspberry Pi 3) in PE_create_console and zeroes 16 KiB there. On SM8550 no RAM covers
# that address, so the region must come from the device tree.
CONFIG_XNU_DT_PANIC_REGION=y
# AMFI waits for an ApplePMGRNub and panics with "AMFI: No PMGR?" without one.
# The bridge (scripts/build-fuxi-platform-power.py, boot arg sheng-pmgr=2) publishes
# the original nub and refuses every power operation with a panic.
CONFIG_XNU_SHENG_PMGR=y
# UFS register/command/block probe (upstream ShengUfs component, NO verified
# policy: no VirtioMmioBlock/Virtio bindings, no VerifiedRoot bundles).
# native-ufs-probe=2 is read-only inspection; =3 adopts the controller.
CONFIG_XNU_NATIVE_UFS=y
# The HID digitizer (scripts/build-fuxi-hid-input.py) and the FTM5 probe
# (scripts/build-fuxi-touch.py, called from bsd_init): force-loaded archives.
# The UFS probe (scripts/build-fuxi-ufs.py): pinned IOBlockStorageDevice imports
# plus probe-only VerifiedRoot stubs, force-loaded after libShengUfs.a so the
# driver's references resolve.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/fuxi-touch/libFuxiTouch.a -Wl,-force_load,{tree}/build/sheng-hid-input/libShengHidInput.a -Wl,-force_load,{tree}/build/fuxi-ufs/libFuxiUfs.a -Wl,-force_load,{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# CONFIG_XNU_NATIVE_UFS is not set (Task 5)
# CONFIG_XNU_NATIVE_ADRENO is not set
